def mask (e : Entry) (r : Fin e.1) (c : Fin e.2.1) := e.2.2.testBit (e.2.1*r.val+c.val)
def label {a b : Nat} [NeZero b] (l : List Nat) (i : Fin a) := Fin.ofNat b (l.getD i.val 0)
def test {R C A B} [NeZero A] [NeZero B] (g : Fin R → Fin C → Bool)
    (s : Fin A → Fin B → Bool) (rr cc : List Nat) : Prop :=
  (∀ i : Fin A, ∃ r : Fin R, label rr r = i) ∧
  (∀ i : Fin B, ∃ c : Fin C, label cc c = i) ∧
  ∀ r c, g r c = s (label rr r) (label cc c)

def corner (i j : Fin 3) := decide
  ((i.val ≤ 1 ∧ j.val ≤ 1 ∧ (i.val < 1 ∨ j.val < 1)) ∨ (i.val = 2 ∧ j.val = 2))

def valid (b : Cert) : Prop :=
  let g := mask b.1
  let t := b.2.1
  let rr := b.2.2.1
  let cc := b.2.2.2
  if t = 0 then test g corner rr cc
  else if t = 1 then test g OriginalCopyFamily_aux.seed rr cc
  else test (fun c r => g r c) OriginalCopyFamily_aux.seed rr cc ∧
    (∃ r c, g r c = true) ∧ (∃ r c, g r c = false)

instance (b : Cert) : Decidable (valid b) := by unfold valid test; infer_instance

set_option maxRecDepth 12000 in
set_option maxHeartbeats 2000000 in
theorem labelsCorrect : ∀ b ∈ certs, valid b := by decide

def exactSize (e : Entry) := ∀ k, RepSizeAtMost (mask e) k ↔ e.1+e.2.1 ≤ k

private theorem ofCore {R C} {g : Fin R → Fin C → Bool} {rr cc}
    (h : test g OriginalCopyFamily_aux.seed rr cc) (k) :
    RepSizeAtMost g k ↔ R+C ≤ k := by
  obtain ⟨ps,qs,eq⟩ := h
  rw [show g = _ from funext (fun r => funext (eq r))]
  exact OriginalCopyFamily R C _ _ ps qs k

private theorem exactOfValid (b : Cert) (h : valid b) : exactSize b.1 := by
  intro k
  unfold valid at h
  dsimp only at h
  split at h
  · obtain ⟨ps,qs,eq⟩ := h
    rw [show mask b.1 = _ from funext (fun r => funext (eq r))]
    obtain ⟨upper,lower,_⟩ := TwinTable _ _ _ _ ps qs
    constructor
    · intro rep
      by_contra! lt
      exact lower k lt rep
    · intro bound
      obtain ⟨circ,ops,size,ev⟩ := upper
      exact ⟨circ,ops,size.trans bound,ev⟩
  · split at h
    · exact ofCore h k
    · obtain ⟨core,⟨r,c,hp⟩,⟨s,d,hq⟩⟩ := h
      have flipped := ofCore core k
      let g := mask b.1
      constructor
      · intro rep
        have le := flipped.mp (CircuitCopies_aux.swapCost (fun x => g x.1 x.2) (r,c) (s,d) hp hq rep)
        omega
      · intro le
        have rep := flipped.mpr (by omega)
        exact CircuitCopies_aux.swapCost (fun x => g x.2 x.1) (c,r) (d,s) hp hq rep

theorem allSizes : ∀ e ∈ certs.map Prod.fst, exactSize e := by
  intro e he
  obtain ⟨b,hb,rfl⟩ := List.mem_map.mp he
  exact exactOfValid b (labelsCorrect b hb)

