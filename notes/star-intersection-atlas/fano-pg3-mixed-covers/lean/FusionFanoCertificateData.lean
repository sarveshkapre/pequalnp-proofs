open scoped BigOperators

abbrev Case := Nat × Nat × Nat

def rows (c : Case) (i : Fin 7) : FusionCube.Code :=
  ⟨(c.1 / 27 ^ i.val) % 27, Nat.mod_lt _ (by decide)⟩

def pairIndex (i j : Fin 7) : Nat :=
  let a := min i.val j.val
  let b := max i.val j.val
  a * (13 - a) / 2 + b - a - 1

def weights (c : Case) (i j : Fin 7) : Int :=
  if i = j then 0 else
    if c.2.1.testBit (pairIndex i j) then 1 else
      if c.2.2.testBit (pairIndex i j) then -1 else 0

theorem weights_diag (c : Case) (i : Fin 7) : weights c i i = 0 := by
  simp [weights]

theorem weights_symm (c : Case) (i j : Fin 7) : weights c i j = weights c j i := by
  simp only [weights, pairIndex, min_comm, max_comm, eq_comm]

def Good (c : Case) : Prop :=
  (0 < ∑ i : Fin 7, ∑ j : Fin 7, weights c i j) ∧
  ∀ i j k : Fin 7, i ≠ j → i ≠ k → j ≠ k →
    0 < weights c i j + weights c i k + weights c j k →
      ∀ s ∈ FusionCube.stars (255 ^^^
        (FusionCube.face (rows c i) ||| FusionCube.face (rows c j) |||
          FusionCube.face (rows c k))),
        ∃ a : Fin 7, a ≠ i ∧ a ≠ j ∧ a ≠ k ∧ FusionCube.face (rows c a) &&& s = 0

def GoodAsc (c : Case) : Prop :=
  (0 < ∑ i : Fin 7, ∑ j : Fin 7, weights c i j) ∧
  ∀ i j k : Fin 7, i < j → j < k →
    0 < weights c i j + weights c i k + weights c j k →
      ∀ s ∈ FusionCube.stars (255 ^^^
        (FusionCube.face (rows c i) ||| FusionCube.face (rows c j) |||
          FusionCube.face (rows c k))),
        ∃ a : Fin 7, a ≠ i ∧ a ≠ j ∧ a ≠ k ∧ FusionCube.face (rows c a) &&& s = 0

noncomputable instance (c : Case) : Decidable (Good c) := by
  unfold Good
  infer_instance

noncomputable instance (c : Case) : Decidable (GoodAsc c) := by
  unfold GoodAsc
