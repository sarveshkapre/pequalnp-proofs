import PEqualNP.SharingRank.Construction
import PEqualNP.SharingRank.Circuit
import PEqualNP.SharingRank.Lower

namespace SharingRank
open Formulas Set
open scoped Classical

/-- Least class generated by rectangles, free intersections, and paid unions,
indexed by the number of paid gates in the expression tree. -/
def FormulaAt {n : Nat} (j : Nat) (z : Region n n) : Prop :=
  ∀ P : Nat → Region n n → Prop,
    (∀ (r c : Set (Fin n)), P 0 (r ×ˢ c)) →
    (∀ i j a b, P i a → P j b → P (i+j) (a ∩ b)) →
    (∀ i j a b, P i a → P j b → P (i+j+1) (a ∪ b)) → P j z

private def region (e : Expr (Fin n) (Fin n)) : Region n n := {p | e.cell p.1 p.2}

private theorem expr_record (e : Expr (Fin n) (Fin n)) : FormulaAt e.cost (region e) := by
  intro P box meet join
  induction e with
  | rect r c => exact box r c
  | meet a b ha hb => exact meet _ _ _ _ ha hb
  | join a b ha hb => exact join _ _ _ _ ha hb

private theorem record_expr {z : Region n n} (h : FormulaAt j z) :
    ∃ e : Expr (Fin n) (Fin n), e.cost = j ∧ region e = z := by
  apply h (fun j z => ∃ e : Expr (Fin n) (Fin n), e.cost = j ∧ region e = z)
  · exact fun r c => ⟨.rect r c,rfl,rfl⟩
  · rintro i j a b ⟨e,rfl,rfl⟩ ⟨f,rfl,rfl⟩
    exact ⟨.meet e f,rfl,rfl⟩
  · rintro i j a b ⟨e,rfl,rfl⟩ ⟨f,rfl,rfl⟩
    exact ⟨.join e f,rfl,rfl⟩

def CircuitAt {n : Nat} (j : Nat) (z : Region n n) : Prop :=
  ∃ (p : Program n n) (q : Port n n), p.length = j ∧ run (wires p) q = z

namespace Family
theorem records (t : Nat) :
    ∃ (n : Nat) (z : Region n n), (indicator z).rank + 2 = 3^(t+3) ∧
      CircuitAt (t+3) z ∧ (∀ j < t+3, ¬ CircuitAt j z) ∧
      FormulaAt (t+4) z ∧ (∀ j < t+4, ¬ FormulaAt j z) := by
  let d := t+2
  refine ⟨_,graphZero d,graph_rank d,circuit_upper d,?_,?_,?_⟩
  · rintro j hj ⟨p,q,len,eq⟩
    have h := (rigidity p q).1
    rw [eq,len] at h
    have peak := graph_rank d
    have low := Nat.pow_le_pow_right (n := 3) (by decide) (show j ≤ t+2 by omega)
    have positive : 3 ≤ 3^(t+2)  := Nat.pow_le_pow_right (n := 3) (by decide) (show 1 ≤ t+2 by omega)
    change _ + 2 = 3 ^ ((t+2)+1) at peak
    rw [pow_succ] at peak
    omega
  · let e := pull (numbering d).symm (explicitFormula d)
    have cost : e.cost = t+4 := by rw [show e.cost = _ from pull_cost ..,explicit_cost]
    have represents : region e = graphZero d := by
      ext ⟨x,y⟩
      exact (pull_cell ..).trans (explicit_cell ..)
    rw [← cost,← represents]
    exact expr_record e
  · intro j cheap rep
    obtain ⟨e,cost,eq⟩ := record_expr rep
    let f := pull (numbering d) e
    have represents (x y : Side d) : f.cell x y ↔ cell d x y = true := by
      rw [show f.cell x y ↔ _ from pull_cell ..]
      have same := Set.ext_iff.mp eq ((numbering d) x,(numbering d) y)
      simpa [region,graphZero] using same
    have h := formula_lower t f represents
    have hc : f.cost = j := (pull_cost ..).trans cost
    omega
end Family
end SharingRank
