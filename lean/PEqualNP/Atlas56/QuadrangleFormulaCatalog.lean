theorem forest_fooling : ∀ i : Fin 48,
    PartialFooling zero (graph \ codeSet (forestCode i)) (forestWitness i) := by
  unfold PartialFooling zero graph mask codeSet forestCode forestWitness
  simp only [mem_sdiff, mem_compl_iff, mem_ofPred_eq]
  decide +kernel

