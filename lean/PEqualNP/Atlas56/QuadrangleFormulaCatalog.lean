theorem forest_index_correct : ∀ (i j : Fin 44),
    Separate (codeSet (rectangleCode i)) (codeSet (rectangleCode j)) →
    codeSet (rectangleCode i) ∪ codeSet (rectangleCode j) ⊆
      codeSet (forestCode (forestIndex i j)) := by
  unfold Separate codeSet rectangleCode forestCode forestIndex
  simp only [mem_ofPred_eq, mem_union, Set.subset_def]
  decide +kernel

theorem complement_catalog {a b : Set Cell} (ha : Rectangle a) (hb : Rectangle b)
    (hz : zero ⊆ a ∪ b) :
    ∃ i : Fin 48, (a ∪ b)ᶜ ⊆ codeSet (forestCode i) := by
  obtain ⟨s,t,hs,ht,hsg,htg,hsep,heq⟩ := quadrangle_complement_two_rectangles ha hb hz
  obtain ⟨i,rfl⟩ := rectangle_catalog hs hsg
  obtain ⟨j,rfl⟩ := rectangle_catalog ht htg
  refine ⟨forestIndex i j, ?_⟩
  rw [heq]
  exact forest_index_correct i j hsep

