import PEqualNP.Atlas56.QuadrangleFormulaForests
import PEqualNP.Atlas56.QuadranglePartialFooling

/-!
Finite geometric certificate for the quadrangle's two-star forests.
Every row/column star has at most three edges. There are 44 distinct sub-stars
(including empty), and 48 maximal unions of two projection-disjoint sub-stars.
The tables are mere data. The coverage and fooling claims below are independently
checked by Lean's kernel, and the preceding generic lemmas prove completeness.
-/
namespace QuadrangleFormulaCatalog
open Set TwoIntersections ThreeIntersectionsQuadrangle QuadrangleFormulaForests
open QuadranglePartialFooling
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def codeSet (n : Nat) : Set Cell :=
  {p | n.testBit (6*p.1.val+p.2.val) = true}

