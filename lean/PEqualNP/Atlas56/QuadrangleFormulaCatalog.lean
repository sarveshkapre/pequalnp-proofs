theorem star_index_correct : ∀ (i : Fin 11) (b : Fin 8) (p : Cell),
    p ∈ selectThree (starPoints i) b ↔ p ∈ codeSet (rectangleCode (starIndex i b)) := by
  unfold selectThree starPoints codeSet rectangleCode starIndex
  simp only [mem_ofPred_eq]
  decide +kernel

theorem rectangle_catalog {s : Set Cell} (hs : Rectangle s) (hg : s ⊆ graph) :
    ∃ i : Fin 44, s = codeSet (rectangleCode i) := by
  obtain ⟨i,b,rfl⟩ := rectangle_star_code hs hg
  exact ⟨starIndex i b, Set.ext (star_index_correct i b)⟩

