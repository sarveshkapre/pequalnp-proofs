def bits (r : Row) (c : Pat) : Nat :=
  let leaf := fun k => rowBits r k &&& colBits c k
  ((leaf 0 ||| leaf 1) &&& (leaf 2 ||| leaf 3)) &&& (leaf 4 ||| leaf 5)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem agree : ∀ (r : Row) (c : Pat), good c &&& bits r c =
    if c.val.testBit r.val then good c else 0 := by decide +kernel

theorem exc_spec : ∀ (c : Pat) (i : Fin 15), (exc c).testBit i.val = true ↔
    ∃ j, c = excCol i j := by decide +kernel

theorem rowMap_inj : ∀ (i : Fin 15) (x y : Row), rowMap i x = rowMap i y → x = y := by
  decide +kernel

