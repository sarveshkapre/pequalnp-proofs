import Mathlib.Tactic

/-! A forest is generated by the empty forest, disjoint concatenation and a new
intersection root with one child forest per arm. The three parameters count its
paid gates, nonleaf paid gates and syntactic rejection certificates. -/
theorem PEqualNP.PaidDepth.FormulaTraceBound :
    ∀ k t n : Nat,
    (∀ P : Nat → Nat → Nat → Prop, P 0 0 1 →
      (∀ a i u b j v, P a i u → P b j v → P (a+b) (i+j) (u*v)) →
      (∀ a i u b j v, P a i u → P b j v →
        P (a+b+1) (i+j+(if a+b=0 then 0 else 1)) (u+v)) →
      P k t n) →
    n * 4^t ≤ 2^k * 3^t := by
  intro k t n generated
  let P (k t n : Nat) := n * 4^t ≤ 2^k * 3^t ∧ 1 ≤ n ∧ (0 < k → 2 ≤ n)
  have joinBound {a i u b j v : Nat} (hu : P a i u) (hv : P b j v) :
      u*v * 4^(i+j) ≤ 2^(a+b)*3^(i+j) := by
    simpa only [pow_add, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using
      Nat.mul_le_mul hu.1 hv.1
  apply (generated P (by decide) ?_ ?_).1
  · intro a i u b j v hu hv
    refine ⟨joinBound hu hv, by simpa using Nat.mul_le_mul hu.2.1 hv.2.1,?_⟩
    intro pos
    by_cases ha : 0 < a
    · exact (hu.2.2 ha).trans (by simpa using Nat.mul_le_mul_left u hv.2.1)
    · have hb : 0 < b := by omega
      exact (hv.2.2 hb).trans (by simpa using Nat.mul_le_mul_right v hu.2.1)
  · intro a i u b j v hu hv
    have pu := hu.2.1
    have pv := hv.2.1
    refine ⟨?_, by omega, fun _ => by omega⟩
    have jb := joinBound hu hv
    have u_le : u ≤ u*v := by simpa using Nat.mul_le_mul_left u pv
    have v_le : v ≤ u*v := by simpa using Nat.mul_le_mul_right v pu
    by_cases h : a+b=0
    · simp only [ite_eq_left h, Nat.add_zero, pow_succ]
      calc (u+v)*4^(i+j) ≤ (2*(u*v))*4^(i+j) :=
              Nat.mul_le_mul_right _ (by omega)
           _ ≤ (2^(a+b)*2)*3^(i+j) := by
              calc _ = 2 * ((u*v)*4^(i+j)) := by ring
                   _ ≤ 2 * (2^(a+b)*3^(i+j)) := Nat.mul_le_mul_left _ jb
                   _ = _ := by ring
    · have loss : 2*(u+v) ≤ 3*(u*v) := by
        by_cases ha : 0 < a
        · have two := hu.2.2 ha
          have twice : 2*v ≤ u*v := Nat.mul_le_mul_right v two
          omega
        · have hb : 0 < b := by omega
          have twice : 2*u ≤ u*v := by
            simpa [Nat.mul_comm] using (Nat.mul_le_mul_left u (hv.2.2 hb))
          omega
      simp only [ite_eq_right h, pow_succ]
      calc (u+v)*(4^(i+j)*4) = 2*((2*(u+v))*4^(i+j)) := by ring
           _ ≤ 2*((3*(u*v))*4^(i+j)) :=
              Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ loss)
           _ = 6*((u*v)*4^(i+j)) := by ring
           _ ≤ 6*(2^(a+b)*3^(i+j)) := Nat.mul_le_mul_left _ jb
           _ = _ := by ring
